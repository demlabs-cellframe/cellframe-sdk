prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Cellframe SDK
Description: Cellframe blockchain SDK (DAP SDK + chains + ledger + compose)
Version: @CELLFRAME_SDK_NATIVE_VERSION@
Requires: dap-sdk
Libs: -L${libdir} -lcellframe_sdk
Cflags: -I${includedir}/cellframe-sdk
